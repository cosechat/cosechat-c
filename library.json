{
  "name": "cosechat",
  "version": "0.2.0",
  "description": "COSE/CBOR mesh chat protocol. Pubkey-addressed, encrypted, spam-resistant via PoW. Inspired by Reticulum/LXMF.",
  "keywords": ["cose", "cbor", "mesh", "chat", "lora", "encryption", "p2p", "iot"],
  "authors": [
    {
      "name": "David Konsumer",
      "email": "konsumer@jetboystudio.com"
    }
  ],
  "license": "MIT",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "headers": "cosechat.h",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "flags": [
      "-DHAVE_DILITHIUM",
      "-DWOLFSSL_WC_DILITHIUM",
      "-DWOLFSSL_HAVE_MLKEM",
      "-DWOLFSSL_WC_MLKEM",
      "-DHAVE_AESGCM",
      "-DHAVE_HKDF",
      "-DWOLFSSL_SHA256",
      "-DWOLFSSL_SHA3",
      "-DHAVE_SHAKE256",
      "-DWOLFSSL_KEY_GEN"
    ]
  },
  "dependencies": {
    "wolfssl": ">=5.0.0",
    "wolfcose": "https://github.com/konsumer/wolfCOSE.git#124ee3c"
  }
}
